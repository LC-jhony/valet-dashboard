server {
    listen 80;
    server_name {{.Domain}};
    return 301 https://$host{{if ne .HTTPSPort 443}}:{{.HTTPSPort}}{{end}}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{.Domain}};
    root {{.DocRoot}};
    index index.php index.html;
    client_max_body_size 64m;

    ssl_certificate     /etc/nginx/certs/sites/{{.Domain}}.crt;
    ssl_certificate_key /etc/nginx/certs/sites/{{.Domain}}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_pass devenv-php{{.NoDot}}-fpm:9000;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 120s;
    }
}
