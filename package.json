{
  "name": "valet-dashboard",
  "version": "0.1.0",
  "description": "Panel de escritorio para gestionar Valet Linux",
  "author": "LC-jhony <jhonyapm94@gmail.com>",
  "desktopName": "valet-dashboard.desktop",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run typecheck && npm run test && bash scripts/build-rpm.sh && electron-builder --linux AppImage deb",
    "test": "vitest run",
    "dist:rpm": "bash scripts/build-rpm.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "dev.valet.dashboard",
    "productName": "Valet Dashboard",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "category": "Development",
      "icon": "build/icons",
      "desktop": {
        "Name": "Valet Dashboard",
        "Comment": "Panel de escritorio para Valet Linux",
        "Categories": "Development;",
        "StartupWMClass": "Valet Dashboard"
      },
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    }
  }
}
